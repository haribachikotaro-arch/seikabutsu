# Next.js: copy to .env.local. Keep MICROCMS_API_KEY server-side; never use a NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
WORKER_API_URL=
MICROCMS_SERVICE=nwh72na5um
MICROCMS_API_KEY=
# Direct local CMS mode needs GET/POST/PATCH/PUT/DELETE plus Media upload permission.
# Enable Retrieve All Drafts only if the key is dedicated to authenticated admin routes.
SITE_ORIGIN=http://127.0.0.1:3001
NEXT_PUBLIC_EMBED_ORIGINS=
# Set your production Clerk frontend API origin for CSP.
CLERK_FRONTEND_ORIGIN=
# Worker secrets: configure with `npx wrangler secret put NAME`.
# CLERK_SECRET_KEY, SCHOOL_DOMAINS (comma-separated exact domains),
# JOIN_CODE_SHA256, MICROCMS_API_KEY
