# Next.js: copy to .env.local. These values are server-only; never use a NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
ALLOWED_EMAIL_DOMAINS=example.ac.jp
DATADREAMERS_INVITE_CODE_HASH=
# Leave WORKER_API_URL empty to let the Next.js server call microCMS directly.
WORKER_API_URL=
WORKER_SHARED_SECRET=
# Used by direct Next.js -> microCMS mode, and kept server-side.
MICROCMS_SERVICE=nwh72na5um
MICROCMS_API_KEY=
# Optional separate CMS proxy. Leave empty for direct Next.js -> microCMS access.
MICROCMS_WORKER_URL=https://microcms-cloudflare-worker.j0120three.workers.dev
MICROCMS_WORKER_TOKEN=
# Direct local CMS mode needs GET/POST/PATCH/PUT/DELETE plus Media upload permission.
# Enable Retrieve All Drafts only if the key is dedicated to authenticated admin routes.
SITE_ORIGIN=http://127.0.0.1:3001
# Set your production Clerk frontend API origin for CSP.
CLERK_FRONTEND_ORIGIN=
# Cloudflare Worker secrets: configure with `npx wrangler secret put NAME`.
# Clerk is used only by Next.js. Never put Clerk keys or Clerk tokens in the Worker.
# Next.js -> Worker server-to-server authentication uses the same WORKER_SHARED_SECRET on both sides.
# CMS proxy: MICROCMS_CONTENT_API_KEY, MICROCMS_MANAGEMENT_API_KEY
# MICROCMS_SERVICE_ID is a non-secret Worker var (configure in wrangler.jsonc or dashboard).
