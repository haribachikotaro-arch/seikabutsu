# Clerk Dashboard > API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me

# Authentication routes
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/portal
NEXT_PUBLIC_CLERK_SIGN_UP_FORCE_REDIRECT_URL=/join

# Comma-separated school email domains. Do not include @.
ALLOWED_EMAIL_DOMAINS=school.example.jp

# Portal roles. The invite code only grants editor; admin is assigned manually.
ALLOWED_ROLES=admin,editor

# Generate this value with: pnpm invite-code
DATADREAMERS_INVITE_CODE_HASH=scrypt$replace_end_replace_me$replace_hash
