{
	"name": "datadreamers-api",
	"main": "worker/index.ts",
	"compatibility_date": "2026-09-01",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "datadreamers",
			"database_id": "f54d17d9-f373-44aa-836d-457a6efabde3",
			"remote": true
		}
	],
"vars": {
  "SITE_ORIGIN": "http://localhost:3001",
  "MICROCMS_SERVICE": "YOUR_SERVICE_ID",
  "MICROCMS_SERVICE_ID": "YOUR_SERVICE_ID",
  "EMBED_ORIGINS": ""
}
}
